TAVILY_API_KEY=tvly-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Instagram Graph API (see SETUP_IG.md)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Where the generated image lives once uploaded. {filename} is substituted.
IMAGE_PUBLIC_URL_TEMPLATE=https://cdn.example.com/bbq/{filename}

# Set to "false" to pause the auto-publisher without editing cron.
PUBLISH_ENABLED=true
